# PDEI web (pdei-web) - browser-visible configuration only.
# Names are normative: docs/PLATFORM-CONTRACT.md §15.

# api-gateway-service REST base (contract §8.1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# api-gateway-service control-tower WebSocket (contract §8.1 streaming)
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/control-tower

# Optional, frontend-local. "true" serves every request from src/mocks so the UI is
# fully explorable with the whole backend down. Leave unset/false against a real gateway.
NEXT_PUBLIC_USE_MOCKS=false

# Optional. simulator-service base (contract 8.5). Defaults to the gateway host on port 8088.
NEXT_PUBLIC_SIM_BASE_URL=http://localhost:8088/sim/v1
