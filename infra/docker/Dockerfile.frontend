# PDEI - frontend (pdei-web, Next.js App Router).
# Build context is the repo root (compose sets context: ..).
#
#   docker build -f infra/docker/Dockerfile.frontend -t pdei/frontend:dev .
#
# Deliberately NOT using output: "standalone": that requires a next.config setting this
# image does not own. A plain `next start` costs a slightly larger image and nothing else.

# --------------------------------------------------------------------------- deps
FROM node:20-alpine AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* frontend/npm-shrinkwrap.json* ./
RUN if [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; then npm ci; else npm install; fi

# --------------------------------------------------------------------------- build
FROM node:20-alpine AS build
WORKDIR /app

# NEXT_PUBLIC_* values are inlined at build time, so they must be build args as well as
# runtime env. These are the host-facing URLs the browser will use.
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/control-tower
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL} \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
RUN mkdir -p ./public && npm run build

# --------------------------------------------------------------------------- runtime
FROM node:20-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    TZ=UTC

RUN addgroup -g 10003 -S pdei && adduser -u 10003 -S pdei -G pdei

# Copying the whole build tree (rather than cherry-picking .next/public/next.config.*)
# keeps this image agnostic about which optional Next.js files the frontend actually has.
COPY --from=build --chown=pdei:pdei /app ./

USER pdei
EXPOSE 3000

CMD ["npx", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
