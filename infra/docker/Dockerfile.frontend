# PDEI - frontend (pdei-web, Next.js App Router).
# Build context is the repo root (compose sets context: ..).
#
#   docker build -f infra/docker/Dockerfile.frontend -t pdei/frontend:dev .
#
# frontend/next.config.ts sets `output: 'standalone'`, so this image runs the standalone
# server. It previously ran `next start` against the full build tree on the assumption that
# standalone was not configured; Next.js 15 rejects that combination out loud at boot:
#
#   ⚠ "next start" does not work with "output: standalone" configuration.
#     Use "node .next/standalone/server.js" instead.
#
# It happened to serve /api/health, which is why the container reported healthy, but the
# arrangement is unsupported. next.config.ts belongs to the frontend module; this file
# follows it rather than the other way round.

# --------------------------------------------------------------------------- deps
FROM node:20-alpine AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* frontend/npm-shrinkwrap.json* ./
RUN if [ -f package-lock.json ] || [ -f npm-shrinkwrap.json ]; then npm ci; else npm install; fi

# --------------------------------------------------------------------------- build
FROM node:20-alpine AS build
WORKDIR /app

# NEXT_PUBLIC_* values are inlined at build time, so they must be build args as well as
# runtime env. These are the host-facing URLs the browser will use.
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/control-tower
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL} \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
RUN mkdir -p ./public && npm run build

# --------------------------------------------------------------------------- runtime
FROM node:20-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    TZ=UTC

RUN addgroup -g 10003 -S pdei && adduser -u 10003 -S pdei -G pdei

# The three pieces a standalone build needs, and nothing else. `server.js` and the traced
# subset of node_modules come from .next/standalone; Next deliberately leaves static assets
# and public/ out of that folder, so they are copied alongside it. The runtime therefore
# carries ~57MB of application (54MB traced node_modules + 2.6MB static) instead of the
# whole build tree with every devDependency in it.
# The build stage runs `mkdir -p ./public`, so public/ always exists even though this
# frontend currently ships no static files.
COPY --from=build --chown=pdei:pdei /app/.next/standalone ./
COPY --from=build --chown=pdei:pdei /app/.next/static ./.next/static
COPY --from=build --chown=pdei:pdei /app/public ./public

USER pdei
EXPOSE 3000

# server.js reads PORT and HOSTNAME from the environment (both set above and re-set by
# compose), so there are no port flags to pass and no npx indirection to resolve.
CMD ["node", "server.js"]
