# PDEI - local environment (EXAMPLE)
#
#   cp infra/.env.example infra/.env      (scripts/bootstrap.sh does this for you)
#
# Docker Compose reads infra/.env automatically when run from infra/. Every value below
# is also the compiled-in default in docker-compose.yml, so an empty .env still boots.
#
# NORMATIVE: docs/PLATFORM-CONTRACT.md section 15. Do not rename these keys.
# These are DEV-ONLY credentials. Nothing here is a secret; nothing here goes to prod.

# ---------------------------------------------------------------------------
# Contract section 15 - shared variable names (consumed by the services)
# ---------------------------------------------------------------------------
PDEI_POSTGRES_URL=jdbc:postgresql://postgres:5432/pdei
PDEI_POSTGRES_USER=pdei
PDEI_POSTGRES_PASSWORD=pdei
PDEI_KAFKA_BOOTSTRAP=kafka:9092
PDEI_REDIS_URL=redis://redis:6379
PDEI_MINIO_ENDPOINT=http://minio:9000
PDEI_MINIO_ACCESS_KEY=pdei-minio
PDEI_MINIO_SECRET_KEY=pdei-minio-secret
PDEI_TEMPORAL_TARGET=temporal:7233
PDEI_TEMPORAL_NAMESPACE=pdei
PDEI_AI_SERVICE_URL=http://ai-reasoning-service:8000
PDEI_AI_PROVIDER=mock
PDEI_API_BASE_URL=http://api-gateway-service:8080
PDEI_SERVICE_TOKEN=dev-service-token
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME is set per service in docker-compose.yml (= the module name).
# Do not set it globally here or every span will be attributed to one service.
# OTEL_SERVICE_NAME=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/control-tower

# ---------------------------------------------------------------------------
# Compose-only knobs (not part of the contract; safe to change locally)
# ---------------------------------------------------------------------------

# Tag applied to the images built from this repo.
PDEI_IMAGE_TAG=dev

# Spring profile activated inside the containers.
SPRING_PROFILES_ACTIVE=docker

# Temporal task queue (contract section 10).
PDEI_TEMPORAL_TASK_QUEUE=pdei-dispute-cases

# Deterministic default seed for the simulator (docs/demo-script.md uses 4281).
PDEI_SIM_DEFAULT_SEED=4281

# Kafka KRaft cluster id. Changing this after first boot invalidates the log dir;
# run scripts/reset.sh if you change it.
PDEI_KAFKA_CLUSTER_ID=pdei-local-cluster-00

# Frontend fixture mode - renders every screen from local fixtures with no API.
NEXT_PUBLIC_USE_MOCKS=false

# Entry point for the Python service (module:attr passed to uvicorn).
PDEI_AI_APP=pdei_ai.main:app

# Grafana login (contract section 2: admin/admin).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Host port overrides - only needed when something already owns the port.
# Container ports never change; these remap the host side only.
# ---------------------------------------------------------------------------
PDEI_POSTGRES_HOST_PORT=5432
PDEI_REDIS_HOST_PORT=6379
PDEI_KAFKA_HOST_PORT=29092
PDEI_KAFKA_UI_HOST_PORT=8090
PDEI_MINIO_HOST_PORT=9000
PDEI_MINIO_CONSOLE_HOST_PORT=9001
PDEI_TEMPORAL_HOST_PORT=7233
PDEI_TEMPORAL_UI_HOST_PORT=8233
PDEI_PROMETHEUS_HOST_PORT=9090
PDEI_GRAFANA_HOST_PORT=3001
PDEI_LOKI_HOST_PORT=3100
PDEI_TEMPO_HOST_PORT=3200
