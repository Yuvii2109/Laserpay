{
  "uid": "pdei-event-pipeline",
  "title": "PDEI / Event Pipeline",
  "description": "Throughput, consumer lag, processing latency and duplicate handling across the Kafka pipeline. Metric names are normative: docs/PLATFORM-CONTRACT.md section 13.",
  "tags": ["pdei", "kafka", "pipeline"],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
        "enable": true,
        "expr": "changes(pdei_chaos_injections_total[1m]) > 0",
        "iconColor": "#d95926",
        "name": "Chaos injections",
        "titleFormat": "Chaos: {{type}}",
        "step": "60s"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
        "query": { "query": "label_values(pdei_events_processed_total, service)", "refId": "service" },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      },
      {
        "name": "topic",
        "label": "Topic",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
        "query": { "query": "label_values(pdei_kafka_consumer_lag, topic)", "refId": "topic" },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Events ingested",
      "description": "pdei_events_ingested_total, all sources. This is the top of the funnel in architecture.md section 2.",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3987e5", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "sum(rate(pdei_events_ingested_total[$__rate_interval]))",
          "legendFormat": "ingested/s",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Events processed",
      "description": "pdei_events_processed_total with outcome=SUCCESS.",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "#0ca30c" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#0ca30c", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "sum(rate(pdei_events_processed_total{outcome=\"SUCCESS\", service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "processed/s",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Duplicates suppressed",
      "description": "pdei_events_duplicate_total. A rising number here during a DUPLICATE_EVENT chaos injection while readiness scores stay flat is the idempotency proof (docs/demo-script.md step 7).",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "#9085e9" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#9085e9", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "sum(increase(pdei_events_duplicate_total{service=~\"$service\"}[$__range]))",
          "legendFormat": "duplicates",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worst consumer lag",
      "description": "Max pdei_kafka_consumer_lag across groups. Sustained growth means a consumer cannot keep up, not that Kafka is slow.",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1000 },
              { "color": "#ec835a", "value": 5000 },
              { "color": "#d03b3b", "value": 25000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "max(pdei_kafka_consumer_lag{topic=~\"$topic\"})",
          "legendFormat": "max lag",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Throughput by service",
      "description": "Successful events per second, per consuming service.",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "events/s",
            "gradientMode": "none"
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ingestion-service" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "normalization-worker" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "state-builder-worker" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "readiness-worker" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "document-processor-service" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d55181" } }] },
          { "matcher": { "id": "byName", "options": "audit-service" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#9085e9" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "sum by (service) (rate(pdei_events_processed_total{service=~\"$service\", outcome=\"SUCCESS\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Throughput by event type",
      "description": "Top 10 canonical event types by rate. The shape of this panel is the shape of the synthetic world the simulator generated.",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "events/s",
            "stacking": { "mode": "none", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "topk(10, sum by (type) (rate(pdei_events_processed_total{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{type}}",
          "range": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "description": "pdei_kafka_consumer_lag by consumer group and topic. Groups are named pdei-<service> (contract section 4).",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "records behind",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "#d03b3b", "value": 5000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "sum by (group, topic) (pdei_kafka_consumer_lag{topic=~\"$topic\"})",
          "legendFormat": "{{group}} / {{topic}}",
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Event processing latency (quantiles)",
      "description": "pdei_event_processing_latency_seconds. Separate panel from throughput on purpose: two units never share one axis.",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisLabel": "seconds"
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(pdei_event_processing_latency_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pdei_event_processing_latency_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pdei_event_processing_latency_seconds_bucket{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Duplicate events suppressed",
      "description": "Idempotency in action: dedupe on eventId via Redis SETNX + the processed_events table (contract section 4).",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "barAlignment": 0,
            "axisLabel": "duplicates/s",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "sum by (service) (rate(pdei_events_duplicate_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Processing outcome mix",
      "description": "SUCCESS vs everything else. A non-zero failure band should always be explainable by a chaos injection or a DLQ entry.",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "axisLabel": "events/s",
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "SUCCESS" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }] },
          { "matcher": { "id": "byName", "options": "RETRY" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#fab219" } }] },
          { "matcher": { "id": "byName", "options": "DLQ" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ec835a" } }] },
          { "matcher": { "id": "byName", "options": "FAILURE" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "sum by (outcome) (rate(pdei_events_processed_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "range": true
        }
      ]
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "Ingested by source",
      "description": "pdei_events_ingested_total by source system over the selected range.",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3987e5", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "sum by (source) (increase(pdei_events_ingested_total[$__range]))",
          "legendFormat": "{{source}}",
          "instant": true
        }
      ]
    },
    {
      "id": 17,
      "type": "table",
      "title": "Per-service scoreboard",
      "description": "One row per consuming service: throughput, duplicates, failures and p99 latency over the selected range. The table view is also the accessible fallback for every panel above.",
      "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99 latency" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 3 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#0ca30c", "value": null },
                    { "color": "#fab219", "value": 0.5 },
                    { "color": "#d03b3b", "value": 2 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "failures" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "text", "value": null },
                    { "color": "#d03b3b", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": { "show": false, "reducer": ["sum"], "fields": "" },
        "sortBy": [{ "displayName": "processed", "desc": true }]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "sum by (service) (increase(pdei_events_processed_total{outcome=\"SUCCESS\"}[$__range]))",
          "legendFormat": "{{service}}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "sum by (service) (increase(pdei_events_duplicate_total[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "sum by (service) (increase(pdei_events_processed_total{outcome!=\"SUCCESS\"}[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "pdei-prometheus" },
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(pdei_event_processing_latency_seconds_bucket[$__rate_interval])))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true },
            "renameByName": {
              "service": "service",
              "Value #A": "processed",
              "Value #B": "duplicates",
              "Value #C": "failures",
              "Value #D": "p99 latency"
            }
          }
        }
      ]
    }
  ]
}
