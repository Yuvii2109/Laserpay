# ---------------------------------------------------------------------------
# ai-reasoning-service (PDEI) — environment
# Shared names come from docs/PLATFORM-CONTRACT.md §15; PDEI_AI_* names that are
# not in §15 are local to this service and documented in context.md.
# ---------------------------------------------------------------------------

# --- provider selection (contract 9.5) -------------------------------------
# gemini | mock | null      Default in dev: mock (works with no API key).
PDEI_AI_PROVIDER=mock
# Ordered fallback chain used when the primary provider is unhealthy.
PDEI_AI_FALLBACK_CHAIN=gemini,mock

# --- Gemini ----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PDEI_AI_TEMPERATURE=0.1
PDEI_AI_MAX_OUTPUT_TOKENS=4096
PDEI_AI_MAX_ATTEMPTS=3

# --- callback into api-gateway-service read-only tools (contract 8.6) ------
PDEI_API_BASE_URL=http://api-gateway-service:8080
PDEI_SERVICE_TOKEN=dev-service-token
PDEI_AI_TOOLS_ENABLED=true
PDEI_AI_TOOL_TIMEOUT_SECONDS=5.0
PDEI_AI_TOOL_MAX_RETRIES=2
PDEI_AI_MAX_TOOL_CALLS=8

# --- budget / rate limiting (contract 9.4, Redis keys in contract 12) ------
PDEI_REDIS_URL=redis://redis:6379
PDEI_AI_DAILY_BUDGET=1000
PDEI_AI_BUCKET_CAPACITY=10
PDEI_AI_BUCKET_REFILL_PER_SECOND=1.0
# When Redis is unreachable: true = allow the call, false = refuse it.
PDEI_AI_BUDGET_FAIL_OPEN=true

# --- admission scoring (contract 9.4) --------------------------------------
PDEI_AI_ADMISSION_THRESHOLD=55
PDEI_AI_FINANCIAL_IMPACT_CAP_MINOR=10000000
PDEI_AI_AMBIGUITY_CAP=8

# --- http surface ----------------------------------------------------------
PDEI_AI_HOST=0.0.0.0
PDEI_AI_PORT=8000
PDEI_AI_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Require X-PDEI-Service-Token on /v1/* (leave false for local demos).
PDEI_AI_REQUIRE_SERVICE_TOKEN=false

# --- observability (contract 13) -------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=ai-reasoning-service
PDEI_AI_LOG_LEVEL=INFO
PDEI_AI_TRACING_ENABLED=true
