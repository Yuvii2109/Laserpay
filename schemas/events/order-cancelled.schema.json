{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pdei.laserpay.com/events/order-cancelled.schema.json",
  "title": "OrderCancelled payload",
  "description": "Order cancelled before or after fulfilment.",
  "x-pdei-event-type": "OrderCancelled",
  "x-pdei-aggregate-type": "ORDER",
  "x-pdei-origin": "EXTERNAL",
  "x-pdei-schema-version": 1,
  "type": "object",
  "required": [
    "orderId",
    "cancelledAt"
  ],
  "properties": {
    "orderId": {
      "$ref": "#/$defs/prefixedId"
    },
    "reason": {
      "type": "string"
    },
    "cancelledBy": {
      "enum": [
        "MERCHANT",
        "CUSTOMER",
        "SYSTEM"
      ]
    },
    "cancelledAt": {
      "$ref": "#/$defs/instant"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "instant": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 instant in UTC, e.g. 2026-08-26T10:15:30.123Z."
    },
    "prefixedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z]{2,4}-[A-Za-z0-9._:-]+$",
      "description": "Human-readable prefixed identifier (PLATFORM-CONTRACT section 5)."
    }
  }
}
