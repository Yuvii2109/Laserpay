{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pdei.laserpay.com/events/case-escalated.schema.json",
  "title": "CaseEscalated payload",
  "description": "Safety gate denied the AI result, or human approval timed out.",
  "x-pdei-event-type": "CaseEscalated",
  "x-pdei-aggregate-type": "CASE",
  "x-pdei-origin": "INTERNAL",
  "x-pdei-schema-version": 1,
  "type": "object",
  "required": [
    "caseId",
    "escalationReason"
  ],
  "properties": {
    "caseId": {
      "$ref": "#/$defs/prefixedId"
    },
    "escalationReason": {
      "type": "string"
    },
    "failedRules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalatedAt": {
      "$ref": "#/$defs/instant"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "instant": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 instant in UTC, e.g. 2026-08-26T10:15:30.123Z."
    },
    "prefixedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z]{2,4}-[A-Za-z0-9._:-]+$",
      "description": "Human-readable prefixed identifier (PLATFORM-CONTRACT section 5)."
    }
  }
}
