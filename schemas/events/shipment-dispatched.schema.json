{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pdei.laserpay.com/events/shipment-dispatched.schema.json",
  "title": "ShipmentDispatched payload",
  "description": "Shipment left the origin hub. Derives SHIPPING_RECORD evidence.",
  "x-pdei-event-type": "ShipmentDispatched",
  "x-pdei-aggregate-type": "SHIPMENT",
  "x-pdei-origin": "EXTERNAL",
  "x-pdei-schema-version": 1,
  "type": "object",
  "required": [
    "shipmentId",
    "dispatchedAt"
  ],
  "properties": {
    "shipmentId": {
      "$ref": "#/$defs/prefixedId"
    },
    "dispatchedAt": {
      "$ref": "#/$defs/instant"
    },
    "originHub": {
      "type": "string"
    },
    "estimatedDeliveryAt": {
      "$ref": "#/$defs/instant"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "instant": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 instant in UTC, e.g. 2026-08-26T10:15:30.123Z."
    },
    "prefixedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z]{2,4}-[A-Za-z0-9._:-]+$",
      "description": "Human-readable prefixed identifier (PLATFORM-CONTRACT section 5)."
    }
  }
}
