{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pdei.laserpay.com/events/dispute-created.schema.json",
  "title": "DisputeCreated payload",
  "description": "A dispute arrived. Starts a DisputeCaseWorkflow (workflow id case-{caseId}); duplicate deliveries are harmless because the workflow id reuse policy absorbs them.",
  "x-pdei-event-type": "DisputeCreated",
  "x-pdei-aggregate-type": "DISPUTE",
  "x-pdei-origin": "EXTERNAL",
  "x-pdei-schema-version": 1,
  "type": "object",
  "required": [
    "disputeId",
    "transactionId",
    "merchantId",
    "reasonCode",
    "disputedAmount",
    "receivedAt"
  ],
  "properties": {
    "disputeId": {
      "$ref": "#/$defs/prefixedId"
    },
    "transactionId": {
      "$ref": "#/$defs/prefixedId"
    },
    "paymentId": {
      "$ref": "#/$defs/prefixedId"
    },
    "merchantId": {
      "$ref": "#/$defs/merchantId"
    },
    "reasonCode": {
      "$ref": "#/$defs/disputeReasonCode"
    },
    "networkReasonCode": {
      "type": "string"
    },
    "disputedAmount": {
      "$ref": "#/$defs/money"
    },
    "status": {
      "$ref": "#/$defs/disputeStatus"
    },
    "deadlineAt": {
      "$ref": "#/$defs/instant"
    },
    "receivedAt": {
      "$ref": "#/$defs/instant"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "disputeReasonCode": {
      "enum": [
        "GOODS_NOT_RECEIVED",
        "SERVICE_NOT_RENDERED",
        "PRODUCT_NOT_AS_DESCRIBED",
        "DUPLICATE_PROCESSING",
        "CREDIT_NOT_PROCESSED",
        "SUBSCRIPTION_CANCELLED",
        "FRAUDULENT_TRANSACTION",
        "UNRECOGNIZED_TRANSACTION",
        "INCORRECT_AMOUNT",
        "PAID_BY_OTHER_MEANS"
      ]
    },
    "disputeStatus": {
      "enum": [
        "OPEN",
        "EVIDENCE_GATHERING",
        "UNDER_INVESTIGATION",
        "AWAITING_HUMAN_REVIEW",
        "REPRESENTMENT_PREPARED",
        "SUBMITTED",
        "WON",
        "LOST",
        "EXPIRED",
        "WITHDRAWN"
      ]
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 instant in UTC, e.g. 2026-08-26T10:15:30.123Z."
    },
    "merchantId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^MER-[A-Za-z0-9._:-]+$"
    },
    "money": {
      "type": "object",
      "title": "Money",
      "description": "Monetary value in minor units. PLATFORM-CONTRACT section 5: never float, never decimal, never a bare number.",
      "required": [
        "amountMinor",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "amountMinor": {
          "type": "integer",
          "description": "Amount in the currency's minor unit (paise, cents)."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO-4217 alphabetic code."
        }
      }
    },
    "prefixedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z]{2,4}-[A-Za-z0-9._:-]+$",
      "description": "Human-readable prefixed identifier (PLATFORM-CONTRACT section 5)."
    }
  }
}
