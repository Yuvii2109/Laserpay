{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pdei.laserpay.com/events/communication-created.schema.json",
  "title": "CommunicationCreated payload",
  "description": "Merchant to customer message. Derives CUSTOMER_COMMUNICATION evidence.",
  "x-pdei-event-type": "CommunicationCreated",
  "x-pdei-aggregate-type": "COMMUNICATION",
  "x-pdei-origin": "EXTERNAL",
  "x-pdei-schema-version": 1,
  "type": "object",
  "required": [
    "communicationId",
    "transactionId",
    "channel",
    "occurredAt"
  ],
  "properties": {
    "communicationId": {
      "$ref": "#/$defs/prefixedId"
    },
    "transactionId": {
      "$ref": "#/$defs/prefixedId"
    },
    "customerId": {
      "$ref": "#/$defs/prefixedId"
    },
    "channel": {
      "enum": [
        "EMAIL",
        "SMS",
        "CHAT",
        "PHONE",
        "IN_APP"
      ]
    },
    "direction": {
      "enum": [
        "OUTBOUND",
        "INBOUND"
      ]
    },
    "subject": {
      "type": "string"
    },
    "bodyPreview": {
      "type": "string"
    },
    "objectKey": {
      "type": "string"
    },
    "occurredAt": {
      "$ref": "#/$defs/instant"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "instant": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 instant in UTC, e.g. 2026-08-26T10:15:30.123Z."
    },
    "prefixedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z]{2,4}-[A-Za-z0-9._:-]+$",
      "description": "Human-readable prefixed identifier (PLATFORM-CONTRACT section 5)."
    }
  }
}
