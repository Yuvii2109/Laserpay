{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pdei.laserpay.com/events/order-created.schema.json",
  "title": "OrderCreated payload",
  "description": "Order placed. Derives ORDER_RECORD evidence, plus INVOICE when the merchant emits one.",
  "x-pdei-event-type": "OrderCreated",
  "x-pdei-aggregate-type": "ORDER",
  "x-pdei-origin": "EXTERNAL",
  "x-pdei-schema-version": 1,
  "type": "object",
  "required": [
    "orderId",
    "transactionId",
    "lines",
    "orderTotal",
    "placedAt"
  ],
  "properties": {
    "orderId": {
      "$ref": "#/$defs/prefixedId"
    },
    "transactionId": {
      "$ref": "#/$defs/prefixedId"
    },
    "customerId": {
      "$ref": "#/$defs/prefixedId"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/orderLine"
      }
    },
    "orderTotal": {
      "$ref": "#/$defs/money"
    },
    "shippingAddress": {
      "$ref": "#/$defs/address"
    },
    "billingAddress": {
      "$ref": "#/$defs/address"
    },
    "placedAt": {
      "$ref": "#/$defs/instant"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "address": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "postalCode": {
          "type": "string"
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 instant in UTC, e.g. 2026-08-26T10:15:30.123Z."
    },
    "money": {
      "type": "object",
      "title": "Money",
      "description": "Monetary value in minor units. PLATFORM-CONTRACT section 5: never float, never decimal, never a bare number.",
      "required": [
        "amountMinor",
        "currency"
      ],
      "additionalProperties": false,
      "properties": {
        "amountMinor": {
          "type": "integer",
          "description": "Amount in the currency's minor unit (paise, cents)."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO-4217 alphabetic code."
        }
      }
    },
    "orderLine": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "sku",
        "quantity"
      ],
      "properties": {
        "sku": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "minimum": 0
        },
        "unitPrice": {
          "$ref": "#/$defs/money"
        },
        "lineTotal": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "prefixedId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z]{2,4}-[A-Za-z0-9._:-]+$",
      "description": "Human-readable prefixed identifier (PLATFORM-CONTRACT section 5)."
    }
  }
}
